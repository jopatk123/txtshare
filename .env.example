NODE_ENV=production
PORT=6006

# 可选：设置对外访问的完整地址，例如 https://your-domain.example
# 生产环境强烈建议显式配置，否则未配置时将拒绝从 Host 头推断分享链接
# 并打印启动告警（避免 Host 注入导致的链接投毒）。
BASE_URL=

# 默认不信任 X-Forwarded-* 请求头。
# 仅当服务部署在反向代理后时才开启，例如单层 Nginx 反代可设置为 1。
TRUST_PROXY=false

# 管理员后台访问令牌，访问 /admin/ 时需要输入
ADMIN_TOKEN=

# CORS 允许的来源：未设置或 * 表示允许任意源（默认）；
# 多源用逗号分隔，例如：https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=